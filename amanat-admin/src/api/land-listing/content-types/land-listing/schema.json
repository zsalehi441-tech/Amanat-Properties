{
    "kind": "collectionType",
    "collectionName": "land_listings",
    "info": {
        "singularName": "land-listing",
        "pluralName": "land-listings",
        "displayName": "Land Listing",
        "description": "Land property listings"
    },
    "options": {
        "draftAndPublish": false
    },
    "pluginOptions": {},
    "attributes": {
        "active_status": {
            "type": "enumeration",
            "enum": [
                "Available",
                "In Negotiation",
                "Sold",
                "Rented"
            ],
            "default": "Available",
            "required": true
        },
        "is_featured": {
            "type": "boolean",
            "default": false
        },
        "listing_type": {
            "type": "enumeration",
            "enum": [
                "Sale",
                "Rent",
                "Gerawi"
            ],
            "default": "Sale",
            "required": true
        },
        "city": {
            "type": "enumeration",
            "enum": [
                "Kabul",
                "Herat",
                "Kandahar",
                "Mazar-i-Sharif",
                "Jalalabad",
                "Bamyan",
                "Ghazni",
                "Khost",
                "Kunduz"
            ],
            "required": true
        },
        "district": {
            "type": "string",
            "required": true
        },
        "price": {
            "type": "biginteger",
            "required": true
        },
        "currency": {
            "type": "enumeration",
            "enum": [
                "USD",
                "AFN"
            ],
            "required": true
        },
        "is_negotiable": {
            "type": "boolean",
            "default": false
        },
        "land_size": {
            "type": "integer",
            "required": true
        },
        "zoning": {
            "type": "string"
        },
        "description_dari": {
            "type": "text",
            "required": true
        },
        "description_pashto": {
            "type": "text"
        },
        "description_english": {
            "type": "text"
        },
        "images": {
            "type": "component",
            "repeatable": true,
            "component": "shared.image-url"
        },
        "video_url": {
            "type": "string"
        },
        "gps_latitude": {
            "type": "decimal"
        },
        "gps_longitude": {
            "type": "decimal"
        },
        "verification_status": {
            "type": "enumeration",
            "enum": [
                "Draft",
                "Verified",
                "Published"
            ],
            "default": "Draft",
            "required": true
        },
        "internal_notes": {
            "type": "text",
            "private": true
        }
    }
}