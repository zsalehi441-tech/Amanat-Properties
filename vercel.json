{
    "version": 2,
    "builds": [
        {
            "src": "amanat-web/package.json",
            "use": "@vercel/vite"
        }
    ],
    "routes": [
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/amanat-web/$1"
        }
    ]
}